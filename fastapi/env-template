# MediEase Clinic Environment Configuration
# Copy this file to .env and fill in your actual credentials
# DO NOT commit .env file to GitHub - it contains sensitive information

# Application Settings
APP_NAME=MediEaseClinic API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# Server Configuration
HOST=0.0.0.0
PORT=8000

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=mediease

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-min-32-characters-long-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AWS Configuration (Required for audio transcription)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=mediease-recordings
S3_TRANSCRIPTS_BUCKET=mediease-transcripts

# OpenAI Configuration (Required for AI note extraction)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4

# Audio Processing Settings
MAX_UPLOAD_SIZE_MB=50
AUDIO_FORMATS_LIST=mp3,wav,m4a,flac
RECORDING_RETENTION_STANDARD=90
RECORDING_RETENTION_EXTENDED=365
RECORDING_RETENTION_PERMANENT=0

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# CORS Settings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
