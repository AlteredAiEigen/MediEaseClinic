# Application Settings
APP_NAME=MediEaseClinic API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# Server Configuration
HOST=0.0.0.0
PORT=8000

# MongoDB Configuration (required for tests)
MONGODB_URL=mongodb://localhost:27017/medieaseclinic
DATABASE_NAME=testdb

# JWT Configuration (required)
JWT_SECRET_KEY=your-secret-key-min-32-characters-long-change-in-production-12345678901234567890123456789012
JWT_REFRESH_SECRET_KEY=your-refresh-secret-key-min-32-characters-long-change-in-production-12345678901234567890123456789012
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AWS Configuration (required)
AWS_ACCESS_KEY_ID=test-key-id
AWS_SECRET_ACCESS_KEY=test-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=test-bucket
AWS_TRANSCRIBE_REGION=us-east-1
AWS_S3_PRESIGNED_URL_EXPIRATION=900

# AWS Transcribe Configuration
AWS_TRANSCRIBE_LANGUAGE_OPTIONS=en-US,hi-IN
AWS_TRANSCRIBE_MEDIA_FORMAT=mp3

# OpenAI Configuration (optional for tests)
OPENAI_API_KEY=test-openai-key
OPENAI_MODEL=gpt-4

# Google Gemini Configuration (optional for tests)
GEMINI_API_KEY=test-gemini-key
GEMINI_MODEL=gemini-pro

# Security Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
ALLOWED_HOSTS=localhost,127.0.0.1

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Encryption Settings (required)
ENCRYPTION_KEY=your-32-byte-encryption-key-change-in-production12345678901234567890123456789012

# File Upload Settings
MAX_UPLOAD_SIZE_MB=100
ALLOWED_AUDIO_FORMATS=mp3,wav,m4a,aac
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,pdf

# HIPAA Audit Logging
AUDIT_LOG_ENABLED=True
AUDIT_LOG_LEVEL=INFO
AUDIT_LOG_RETENTION_DAYS=2555
ENABLE_AUDIT_LOGGING=True
ENABLE_DATA_MASKING=True
PHI_ENCRYPTION_ENABLED=True

# Recording Retention Policies (in days)
RECORDING_RETENTION_STANDARD=90
RECORDING_RETENTION_EXTENDED=365
RECORDING_RETENTION_PERMANENT=0

# Email Configuration (optional for tests)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=test@example.com
SMTP_PASSWORD=test-password
SMTP_FROM=noreply@medieaseclinic.com
